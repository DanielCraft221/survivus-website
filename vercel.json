{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/security.txt",
      "destination": "/.well-known/security.txt",
      "permanent": true
    },
    {
      "source": "/discord",
      "destination": "https://discord.gg/aa4RtDt4ra",
      "permanent": false
    },
    {
      "source": "/loja",
      "destination": "https://survivus.pixelcart.com.br",
      "permanent": true
    },
    {
      "source": "/tiktok",
      "destination": "https://www.tiktok.com/@survivusmc",
      "permanent": true
    },
    {
      "source": "/youtube",
      "destination": "https://www.youtube.com/@survivus",
      "permanent": true
    },
    {
      "source": "/instagram",
      "destination": "https://www.instagram.com/survivus",
      "permanent": true
    }
  ]
}
