{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/discord",
      "destination": "https://discord.gg/aa4RtDt4ra",
      "permanent": false
    },
    {
      "source": "/loja",
      "destination": "https://survivus.pixelcart.com.br",
      "permanent": false
    },
    {
      "source": "/tiktok",
      "destination": "https://www.tiktok.com/@survivusmc",
      "permanent": false
    },
    {
      "source": "/youtube",
      "destination": "https://www.youtube.com/@survivus",
      "permanent": false
    },
    {
      "source": "/instagram",
      "destination": "https://www.instagram.com/survivus",
      "permanent": false
    }
  ]
}
